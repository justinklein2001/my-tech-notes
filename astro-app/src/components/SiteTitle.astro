---
import type { Props } from '@astrojs/starlight/props';

const links = [
    { name: "Portfolio", href: "https://justinklein.ca" },
    { name: "Get Quizzed", href: "https://get-quizzed.justinklein.ca" },
];
---

<div class="site-branding">
    <a href="/" class="site-title">
      Justin Klein
    </a>
    {links.map(link => (
        <div class="nav-item">
            <span class="separator">|</span>
            <a href={link.href} class="nav-link" target="_blank" rel="noopener noreferrer">{link.name}</a>
        </div>
    ))}
</div>

<style>
  .site-branding {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-title {
    color: var(--sl-color-text);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-title:hover {
      opacity: 0.8;
  }
  .nav-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
  }
  .separator {
      color: var(--sl-color-gray-4);
  }
  .nav-link {
      color: var(--sl-color-gray-3);
      text-decoration: none;
      font-weight: 400;
      white-space: nowrap;
  }
  .nav-link:hover {
      color: var(--sl-color-text);
  }
  
  @media (max-width: 720px) {
      .nav-item {
          display: none;
      }
  }
</style>
